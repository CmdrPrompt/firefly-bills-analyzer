# firefly-bills-analyzer — configuration template
# Copy to .env and fill in your values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

FIREFLY_URL=https://firefly.example.com
FIREFLY_TOKEN=your-personal-access-token

# ---------------------------------------------------------------------------
# Analysis (optional — defaults shown)
# ---------------------------------------------------------------------------

# LOOKBACK_MONTHS=24
# MIN_OCCURRENCES=2
# AMOUNT_MARGIN=0.10
# AMOUNT_CLUSTER_TOLERANCE=0.15
# HIGH_CONFIDENCE_THRESHOLD=0.80
# CATEGORY_CONFIDENCE_BOOST=0.15
# CATEGORY_MAJORITY_THRESHOLD=0.80
# UNCATEGORIZED_CONFIDENCE_PENALTY=0.10
# UNCATEGORIZED_BEHAVIOR=neutral
# INCLUDE_CATEGORIES=
# EXCLUDE_CATEGORIES=
# INCLUDE_ACCOUNTS=
# EXCLUDE_ACCOUNTS=
# INCLUDE_PAYEES=
# EXCLUDE_PAYEES=

# ---------------------------------------------------------------------------
# Income detection (optional — UC12, defaults shown)
# ---------------------------------------------------------------------------

# INCOME_ACCOUNTS=
# INCOME_MIN_OCCURRENCES=3
# INCOME_VARIANCE_TOLERANCE=0.10

# ---------------------------------------------------------------------------
# Household spend (optional — UC13, defaults shown)
# ---------------------------------------------------------------------------

# HOUSEHOLD_SPEND_CATEGORIES=
# HOUSEHOLD_SPEND_ONE_OFF_THRESHOLD=2000
# Per-category overrides of the threshold above, as comma-separated
# category:amount pairs, e.g. Mat och hushåll:3000,Transport:6000
# HOUSEHOLD_SPEND_ONE_OFF_THRESHOLDS=
# HOUSEHOLD_SPEND_MIN_MONTHS=3
# HOUSEHOLD_SPEND_INCLUDE_TAG=
# HOUSEHOLD_SPEND_EXCLUDE_TAG=

# ---------------------------------------------------------------------------
# Output (optional — defaults shown)
# ---------------------------------------------------------------------------

# DRY_RUN=false
# EXPORT_FORMAT=none

# ---------------------------------------------------------------------------
# Web server (optional — defaults shown)
# ---------------------------------------------------------------------------

# WEB_PORT=5000
# WEB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Cache (optional — defaults shown, TTL in seconds)
# ---------------------------------------------------------------------------

# CACHE_DIR=./cache
# CACHE_TTL_CATEGORIES=86400
# CACHE_TTL_BILLS=3600
# CACHE_TTL_TRANSACTIONS=3600
# CACHE_TTL_PAYEES=86400
